KITTY_INCLUDE="${XDG_CONFIG_HOME:-$HOME/.config}/theme-sync/themes/SupaTheme/extras/kitty/SupaTheme.conf"
NVIM_THEME="SupaTheme"
BAT_THEME="SupaTheme"
BAT_THEME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/theme-sync/themes/SupaTheme/extras/bat/SupaTheme.tmTheme"
FZF_THEME_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/theme-sync/themes/SupaTheme/extras/fzf/SupaTheme.sh"
STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/theme-sync/themes/SupaTheme/extras/starship/SupaTheme.toml"
